# OrchardPatch Waitlist — Environment Variables
# Copy this file to .env.local and fill in values as needed.

# ── Future: Email backend integration ──────────────────────────────────────────

# Option A: File-based storage (no external service)
# WAITLIST_STORAGE_PATH=./data/waitlist.json

# Option B: Database URL (e.g. Supabase, PlanetScale, Railway)
# DATABASE_URL=

# Option C: Email service API keys
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# CONVERTKIT_API_KEY=
# CONVERTKIT_FORM_ID=

# ── Site metadata ──────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SITE_URL=https://orchardpatch.com
